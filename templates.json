    {
      "id": 1,
      "type": 3,
      "title": "GNU Health",
      "description": "Docker image for GNU Health a free/libre health and hospital information system.",
      "categories": ["Health"],
      "platform": "linux",
      "logo": "https://raw.githubusercontent.com/business-web-services/portainer-templates/main/stacks/gnuhealth/logo/logo.png",
      "repository": {
        "url": "https://github.com/business-web-services/portainer-templates",
        "stackfile": "stacks/gnuhealth/docker-compose.yml"
      },
      "env": [
        {
          "name": "TIMEZONE",
          "label": "Timezone",
          "default": "America/Santo_Domingo"
        },
        {
          "name": "POSTGRES_IMAGE",
          "label": "Postgres Image",
          "default": "code.rserverd.com/gruposolutema/postgres"
        },
        {
          "name": "POSTGRES_TAG",
          "label": "Postgres Tag",
          "default": "16.6"
        },
        {
          "name": "DB_NAME",
          "label": "Database Name"
        },
        {
          "name": "DB_USER",
          "label": "Database User"
        },
        {
          "name": "DB_PASS",
          "label": "Database Password for User"
        },
        {
          "name": "SUPERUSER_PASS",
          "label": "Database Password for Root"
        },

        {
          "name": "DB_EXTENSION",
          "label": "Database extensions",
          "default": "unaccent"
        },
        {
          "name": "GNUHEALTH_IMAGE",
          "label": "GNU Health Image",
          "default": "code.rserverd.com/gruposolutema/gnuhealth"
        },
        {
          "name": "GNUHEALTH_TAG",
          "label": "GNU Health Tag",
          "default": "latest"
        },
        {
          "name": "GNUHEALTH_LANGUAGE",
          "label": "GNU Health Language",
          "default": "es_419"
        },
        {
          "name": "EMAIL",
          "label": "E-Mail",
          "default": "admin@example.com"
        },
        {
          "name": "PASSWORD",
          "label": "Password",
          "default": "admin"
        },
        {
          "name": "URL",
          "label": "URL",
          "default": "demo.example.com"
        },
        {
          "name": "NETWORK",
          "label": "Network",
          "default": "proxy"
        }
      ],
      "ports": ["8000/tcp"],
      "volumes": [
        {
          "container": "/var/lib/postgresql/data"
        },
        {
          "container": "/var/lib/trytond/db"
        }
      ]
    },
